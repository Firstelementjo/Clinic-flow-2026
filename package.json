{
  "name": "firstelement",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@1.22.22",
  "description": "FirstElement Dental Clinic - patient management, appointments, odontogram, treatment plans, billing",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "yarn workspace @firstelement/database prisma:generate",
    "db:migrate": "yarn workspace @firstelement/database prisma:migrate",
    "db:push": "yarn workspace @firstelement/database prisma:push",
    "db:seed": "yarn workspace @firstelement/database seed",
    "dev:api": "yarn workspace @firstelement/api dev",
    "dev:web": "yarn workspace @firstelement/web dev",
    "dev:worker": "yarn workspace @firstelement/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  }
}
