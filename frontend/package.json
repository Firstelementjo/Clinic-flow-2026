{
  "name": "@firstelement/angular",
  "version": "0.1.0",
  "description": "FirstElement Angular client — the target-stack replacement for apps/web (Phase 11)",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "generate:api": "node tools/generate-api.mjs",
    "generate:api:check": "node tools/generate-api.mjs --check",
    "e2e": "playwright test --reporter=line",
    "e2e:list": "playwright test --list",
    "e2e:ui": "playwright test --project=chromium --ui",
    "e2e:seed": "tsx e2e/seed.cli.ts seed",
    "e2e:teardown": "tsx e2e/seed.cli.ts teardown"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "bcryptjs": "^3.0.3",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
