# ---------------------------------------------------------------------------
# FirstElement — environment template. Copy to .env and fill in.
# NEVER commit a real .env. No real secrets belong in this file.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- Core services ---------------------------------------------------------
DATABASE_URL=postgresql://firstelement:firstelement@localhost:5432/firstelement
REDIS_URL=redis://localhost:6379

# --- API / web -------------------------------------------------------------
API_PORT=4000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
API_URL=http://localhost:4000

# --- Security --------------------------------------------------------------
# 32+ random chars. Signs session cookies.
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
# Exactly 64 hex chars (32 bytes). Encrypts connector credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# LEFT EMPTY ON PURPOSE. It was previously a run of 64 zeros, which is a
# well-formed key: copying this template to .env and starting without rotating
# would have encrypted every WhatsApp/Telegram credential under a key published
# in the repository, and nothing at boot rejects a low-entropy key. An empty
# value fails loudly instead of silently working.
ENCRYPTION_KEY=
SESSION_TTL_HOURS=720

# --- Platform console (internal operators only, never reachable by a customer) ----
# OFF by default. While it is off, /api/v1/platform/** has no handler at all: the
# console is absent rather than open, so a deployment that never opts in publishes
# no cross-tenant surface. Turning it on additionally requires ENCRYPTION_KEY above,
# because an operator's TOTP shared secret must be decryptable to verify a second
# factor and therefore cannot be stored as a one-way hash.
#
# See docs/migration/adr/0023-platform-console-is-opt-in-and-separately-chained.md
PLATFORM_CONSOLE_ENABLED=false

# --- AI providers (server-side only, never exposed to the frontend) --------
AI_PROVIDER=mock
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
LOCAL_AI_BASE_URL=
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536

# --- Messaging connectors --------------------------------------------------
# Leave blank to run with the MockConnector only (see docs/connectors.md).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Storage ---------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=

# --- Queues ----------------------------------------------------------------
# redis  = hand work to the BullMQ worker (required in production)
# inline = process in the API process; development without Redis only
QUEUE_DRIVER=redis

# --- Dev conveniences ------------------------------------------------------
# Enables POST /api/dev/mock/incoming-message. Must be false outside development.
# The server also refuses it under a production profile, but that refusal is a
# backstop, not a plan: a template that ships the simulator ON makes the
# dangerous value the path of least resistance for whoever deploys first.
# Set true deliberately, for local development only.
ENABLE_MOCK_CONNECTOR=false
