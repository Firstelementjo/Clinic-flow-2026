    },
    {
      "id": "customer.byId.crossProject.agentA1",
      "group": "authorization",
      "principal": "agentA1",
      "method": "GET",
      "path": "/customers/$custA2",
      "why": "DENY: same tenant, other project, by direct id"
    },
    {
      "id": "customer.byId.crossProject.agentA2",
      "group": "authorization",
      "principal": "agentA2",
      "method": "GET",
      "path": "/customers/$custA1",
