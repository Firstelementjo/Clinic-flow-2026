  "forbiddenStringsNote": "Every one of these is the CONTENT of a row in dataset/seed-core.sql -- a customer display name, a ticket number, a note body, a message body or a subject. None of them may appear in the body of a refusal. The list is the dataset's own contents, not an expectation about what a runtime 'should' hide, so a refusal that echoes any of them is disclosing. A refusal for a request in the `authorization` group is scanned against the whole list.",

  "principals": {
    "adminA": {
      "email": "shadow-admin-a@shadow.invalid",
      "org": "A",
      "role": "ADMIN",
      "projects": ["projA1", "projA2"],
      "why": "two projects in one tenant, so a cross-project ALLOW is a real case rather than an accident of membership"
    },
    "agentA1": {
      "email": "shadow-agent-a1@shadow.invalid",
      "org": "A",
      "role": "EMPLOYEE",
      "projects": ["projA1"],
      "why": "member of A1 only; every A2 request must be DENIED"
    },
    "agentA2": {
      "email": "shadow-agent-a2@shadow.invalid",
      "org": "A",
      "role": "EMPLOYEE",
      "projects": ["projA2"],
      "why": "member of A2 only; every A1 request must be DENIED"
    },
    "adminB": {
      "email": "shadow-admin-b@shadow.invalid",
      "org": "B",
      "role": "ADMIN",
      "projects": ["projB1"],
      "why": "a different tenant; every A request must be DENIED"
    },
    "anonymous": {
      "email": null,
      "why": "no session at all; every request must be DENIED"
    }
  },

  "resources": {
