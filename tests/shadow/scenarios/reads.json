    "projB1": "b1b1b1b1-0000-4000-8000-000000000001",
    "projC1": "c1c1c1c1-0000-4000-8000-000000000001",
    "custA1": "ca000001-0000-4000-8000-000000000001",
    "custA1b": "ca000001-0000-4000-8000-000000000002",
    "custA2": "ca000002-0000-4000-8000-000000000001",
    "custB1": "cb000001-0000-4000-8000-000000000001",
    "cxA1": "#33000001",
