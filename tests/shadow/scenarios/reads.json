  "requests": [
    {
      "id": "customers.all.adminA",
      "group": "row-counts",
      "principal": "adminA",
      "method": "GET",
      "path": "/customers",
      "why": "every project the principal can see; the item count and the id set are the row-count comparison"
    },
    {
      "id": "customers.all.agentA1",
      "group": "row-counts",
      "principal": "agentA1",
      "method": "GET",
      "path": "/customers",
      "why": "same call as adminA from a single-project principal; if the filter were the organization instead of the accessible projects, this is where it shows"
    },
    {
      "id": "customers.all.agentA2",
      "group": "row-counts",
      "principal": "agentA2",
      "method": "GET",
      "path": "/customers",
      "why": "the mirror of agentA1; together the two pin the project filter to membership"
    },
    {
      "id": "customers.all.adminB",
      "group": "row-counts",
      "principal": "adminB",
      "method": "GET",
      "path": "/customers",
      "why": "a tenant-scoped list must contain zero rows from another tenant"
    },
    {
      "id": "customers.projA1.adminA",
      "group": "row-counts",
      "principal": "adminA",
      "method": "GET",
      "path": "/customers",
      "query": { "projectId": "$projA1" },
      "why": "explicit project filter, the shape the inbox uses"
    },
    {
      "id": "customers.projA2.adminA",
      "group": "row-counts",
      "principal": "adminA",
      "method": "GET",
      "path": "/customers",
      "query": { "projectId": "$projA2" },
      "why": "the second project of the same tenant"
    },
    {
      "id": "customers.projA1.agentA1",
      "group": "authorization",
      "principal": "agentA1",
      "method": "GET",
      "path": "/customers",
      "query": { "projectId": "$projA1" },
      "why": "ALLOW: the principal is a member of this project"
    },
    {
      "id": "customers.projA2.agentA1",
      "group": "authorization",
      "principal": "agentA1",
      "method": "GET",
      "path": "/customers",
      "query": { "projectId": "$projA2" },
      "why": "DENY: same tenant, project the principal does not belong to. A client-supplied projectId is a request, not authorization."
    },
    {
      "id": "customers.projA1.agentA2",
      "group": "authorization",
      "principal": "agentA2",
      "method": "GET",
      "path": "/customers",
      "query": { "projectId": "$projA1" },
      "why": "DENY: the mirror of the previous case"
    },
    {
      "id": "customers.projB1.adminA",
      "group": "authorization",
      "principal": "adminA",
      "method": "GET",
      "path": "/customers",
      "query": { "projectId": "$projB1" },
      "why": "DENY: another tenant's project, requested by an administrator of the first"
    },
    {
      "id": "customers.projA1.anonymous",
      "group": "authorization",
      "principal": "anonymous",
      "method": "GET",
      "path": "/customers",
      "query": { "projectId": "$projA1" },
      "why": "DENY: no session"
    },
    {
