{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "PROJECT_REQUIREMENTS.md",
    "plan.md",
    "PR.md",
    "OPENCODE_ORCHESTRATOR.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push *": "deny",
      "git reset --hard*": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "dropdb *": "deny",
      "docker system prune*": "deny"
    },
    "task": {
      "*": "deny",
      "firstelement-*": "allow"
    },
    "external_directory": "deny"
  }
}
